{
  "name": "codex-bridge",
  "version": "0.1.0",
  "description": "Desktop utility for copying, cloning, exporting, and importing Codex Desktop conversations.",
  "author": "Linderpock",
  "type": "module",
  "main": "src/electron-main.js",
  "bin": {
    "codex-bridge": "./src/cli.js"
  },
  "scripts": {
    "check": "node --check src/cli.js && node --check src/electron-main.js && node --check src/profile-utils.js && node --check src/provider-clone.js && node --check src/state-sync.js",
    "desktop:app": "electron .",
    "package:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "package:win:dir": "electron-packager . \"CodexBridge\" --platform=win32 --arch=x64 --out=release-packager --overwrite --prune=true --ignore=\"^/(release|release-packager|dist|exports|tmp)\"",
    "package:mac": "electron-builder --mac zip",
    "package:linux": "electron-builder --linux zip"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.wufal.codexbridge",
    "productName": "CodexBridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "web/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "zip"
      ]
    },
    "portable": {
      "artifactName": "CodexBridge-Desktop.exe"
    }
  },
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
